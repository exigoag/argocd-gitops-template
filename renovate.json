{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "OCI-based Helm charts",
      "managerFilePatterns": [
        "/app\\.yaml$/"
      ],
      "matchStringsStrategy": "recursive",
      "datasourceTemplate": "docker",
      "versioningTemplate": "helm",
      "matchStrings": [
        "repoURL:\\s*\"oci://(?<registryUrl>[^/]+)/(?<path>.*)\"[\\s\\S]*?srcChart:\\s*\"(?<chart>.*)\"[\\s\\S]*?srcTargetRevision:\\s*\"(?<currentValue>.*)\""
      ],
      "depNameTemplate": "{{chart}}",
      "packageNameTemplate": "{{path}}/{{chart}}",
      "registryUrlTemplate": "https://{{registryUrl}}"
    },
    {
      "customType": "regex",
      "description": "Standard Helm charts (HTTP/HTTPS)",
      "managerFilePatterns": [
        "/app\\.yaml$/"
      ],
      "matchStringsStrategy": "recursive",
      "datasourceTemplate": "helm",
      "versioningTemplate": "helm",
      "matchStrings": [
        "repoURL:\\s*\"(?<registryUrl>https?://\\S+)\"[\\s\\S]*?srcChart:\\s*\"(?<depName>\\S+)\"[\\s\\S]*?srcTargetRevision:\\s*\"(?<currentValue>\\S+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "**/dev-cluster/**"
      ],
      "labels": [
        "env:nonprod"
      ],
      "groupName": "nonprod",
      "automerge": true,
      "minimumReleaseAge": "2 days",
      "prPriority": 20
    },
    {
      "matchFileNames": [
        "**/in-cluster/**",
        "**/prod-cluster/**"
      ],
      "labels": [
        "env:prod"
      ],
      "groupName": "prod",
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "prPriority": 0
    }
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 1,
  "prHourlyLimit": 0,
  "separateMajorMinor": true,
  "separateMinorPatch": true,
  "commitMessagePrefix": "chore(deps): "
}
